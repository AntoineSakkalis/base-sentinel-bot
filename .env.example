# Base Sentinel Bot Environment Variables

# M2M Sentinel API Configuration (Optional: demo mode works without API key)
M2M_BASE_URL=https://m2msentinel.vercel.app
M2M_API_KEY=

# Discord Bot Configuration (Optional: leave blank if only using Telegram/CLI)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Telegram Bot Configuration (Optional: leave blank if only using Discord/CLI)
TELEGRAM_BOT_TOKEN=

# Risk Thresholds
MAX_SAFE_RISK_SCORE=40
HIGH_RISK_THRESHOLD=70
